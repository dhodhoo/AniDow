# AniDow — Environment Variables
# Salin ke .env.local untuk development, atau set di dashboard Vercel untuk production.

# === MovieBox API (Film & TV) ===
# Base URL server-side (Next.js API routes dan server components akses ini)
MOVIEBOX_API_BASE_URL=http://127.0.0.1:8000
# API key untuk header X-API-Key (server-side only, tidak pernah bocor ke browser)
MOVIEBOX_API_KEY=your_moviebox_api_key_here
# Base URL publik untuk stream/subtitle (HMAC-signed URLs — tanpa API key di browser)
# Production: https://moviebox-api.nexaworks.me
NEXT_PUBLIC_MOVIEBOX_BASE=http://127.0.0.1:8000

# === Anime API (Otakudesu) ===
# Opsional — fallback legacy
OTAKUDESU_API_KEY=your_otakudesu_api_key_here
